{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "workers-cache-for-keys-cache-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-21",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"upload_source_maps": true,
	"r2_buckets": [
		{
			"binding": "KEY_BUCKET",
			"bucket_name": "workers-cache-for-keys"
		}
	],
	"queues": {
		"consumers": [
			{
				"queue": "workers-cache-for-keys-r2-events",
				"max_batch_size": 10,
				"max_batch_timeout": 5,
				"max_retries": 5
			}
		]
	}
}
